# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values you want to use.
#   cp .env.example .env
#
# .env is git-ignored. Keys are never shown in the UI or written to reports.
# The app runs fine with both keys empty (offline analysis only).
# ---------------------------------------------------------------------------

# VirusTotal API v3 key (free tier works). https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# OpenAI API key. Optional - only used when "AI explanation" is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Maximum number of IOCs sent to VirusTotal per analysis (free tier is 4/min).
MAX_VT_LOOKUPS=4
